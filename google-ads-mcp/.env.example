# ============================================================
# Google Ads MCP — Credenciais necessárias
# Copie este ficheiro para .env e preencha os valores abaixo
# ============================================================
#
# PASSO 1 — Google Cloud Console (console.cloud.google.com)
#   • Crie um projeto novo (ex: "nowa-ads-mcp")
#   • Ative a API: APIs & Serviços → Biblioteca → "Google Ads API" → Ativar
#   • Crie credenciais OAuth: APIs & Serviços → Credenciais → Criar credenciais
#     → ID do cliente OAuth → Tipo: "App para computador" → Criar
#   • Copie o Client ID e Client Secret abaixo
#
# PASSO 2 — Developer Token (ads.google.com)
#   • Acesse a conta MCC 710-695-1176 no Google Ads
#   • Ferramentas e configurações → Configuração → Centro de API
#   • Solicite acesso de desenvolvedor (leva alguns dias para aprovar)
#   • Copie o token abaixo (começa com algo como "Ab12Cd_efGh...")
#
# PASSO 3 — Refresh Token (gerado via script get-token.js)
#   • Execute: node get-token.js
#   • Faça login com a conta Google da MCC quando o browser abrir
#   • Cole o código de autorização no terminal
#   • Copie o refresh_token gerado abaixo

GOOGLE_ADS_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
GOOGLE_ADS_DEVELOPER_TOKEN=SEU_DEVELOPER_TOKEN_AQUI
GOOGLE_ADS_REFRESH_TOKEN=SEU_REFRESH_TOKEN_AQUI

# ID da conta MCC (sem hífens ou com — ambos funcionam)
GOOGLE_ADS_MCC_ID=7106951176

# ID da conta cliente padrão (Advant Tecnologia) — pode deixar vazio
# e passar customer_id em cada tool call individualmente
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=
